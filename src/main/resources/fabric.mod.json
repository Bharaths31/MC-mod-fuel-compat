    ]
  },
  "mixins": [
    "ia-fuel-compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "fabric-api": ">=0.116.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
